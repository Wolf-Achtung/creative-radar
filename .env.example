# ---------------------------------------------------------------------------
# Creative Radar — Backend ENV-Beispiel
# Diese Datei spiegelt app/config.py Settings. Alle Schlüssel sind in Großbuchstaben
# (pydantic-settings ist case-insensitive). Werte sind Defaults oder Platzhalter.
# Lokal nach `.env` kopieren, in Railway als ENV-Variablen pflegen.
# ---------------------------------------------------------------------------

# --- App ---
# production | staging | development. Bei "staging" greift der Boot-Check
# (STAGING_EXPECTED_DB_HOST) und der interne Cron-Scheduler ist ohne
# explizites ENABLE_INTERNAL_CRON_SCHEDULER aus.
APP_ENV=production
APP_NAME=creative-radar

# --- Staging/Dev (docs/STAGING_SETUP.md) ---
# Whitelist-Boot-Check: bei APP_ENV=staging Pflicht — Host der
# Staging-Postgres; Boot bricht ab, wenn DATABASE_URL woanders hinzeigt.
STAGING_EXPECTED_DB_HOST=
# true = Apify/TikTok/YouTube liefern deterministische Fixtures statt
# echter Calls (kein Token noetig, keine Kosten). Prod: false.
MOCK_EXTERNAL_APIS=false

# --- Datenbank ---
# Railway Postgres setzt DATABASE_URL automatisch, sobald Postgres mit dem Backend verbunden ist.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Optionale Railway-spezifische Varianten (eine reicht):
DATABASE_PRIVATE_URL=
DATABASE_PUBLIC_URL=
# Fallback auf einzelne PG*-Variablen, falls keine *_URL gesetzt ist:
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
# Nur für lokale Entwicklung ohne Postgres aktivieren — niemals in Production.
ALLOW_SQLITE_FALLBACK=false

# --- CORS / URLs ---
# Fester Origin, kein Wildcard: CORS läuft mit allow_credentials=True
# (Admin-Session-Cookie), "*" würde dann jede beliebige Website
# credentialed Cross-Origin-Requests machen lassen (Starlette spiegelt bei
# allow_origins=["*"] den Request-Origin zurück, sobald credentials=True
# gesetzt ist). Komma-separierte Liste für mehrere Origins möglich.
CORS_ORIGINS=https://app.creative-radar.de
FRONTEND_URL=https://app.creative-radar.de
BACKEND_URL=https://api.creative-radar.de

# --- OpenAI ---
# Übernimmt Creative-Zusammenfassung einzelner Assets und Report-Summary.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- Anthropic (Sprint 5.3.1) ---
# Hybrid-Modellstrategie: Haiku für mechanische Felder (Format/Tone), Sonnet
# für kontextuelle Felder (Purpose/Lifecycle) + Vision, Opus für die
# Wochenbrief-Generierung. Modell-IDs sind hier überschreibbar, ohne dass ein
# Code-Deploy nötig ist, falls ein Provider-Modell abgekündigt wird.
ANTHROPIC_API_KEY=
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_SONNET_MODEL=claude-sonnet-5
ANTHROPIC_OPUS_MODEL=claude-opus-4-8
ANTHROPIC_HAIKU_INPUT_PER_1K_USD=0.001
ANTHROPIC_HAIKU_OUTPUT_PER_1K_USD=0.005
# Standard-Rate ab 01.09.2026 (Sonnet 5 laeuft bis dahin mit Einfuehrungspreis
# $2/$10 pro Mtok = 0.002/0.010 pro 1k).
ANTHROPIC_SONNET_INPUT_PER_1K_USD=0.003
ANTHROPIC_SONNET_OUTPUT_PER_1K_USD=0.015
ANTHROPIC_OPUS_INPUT_PER_1K_USD=0.005
ANTHROPIC_OPUS_OUTPUT_PER_1K_USD=0.025

# --- TMDb ---
# Whitelist-Quelle für Filme/Serien (siehe Roadmap MVP-Scope).
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# --- YouTube Data API v3 (Sprint 5.2.3) ---
# Free Tier: 10k Quota-Units/Tag; ein Channel-Sync kostet 3 Units.
YOUTUBE_API_KEY=
YOUTUBE_RESULTS_LIMIT_PER_CHANNEL=10

# --- Apify ---
# Scraper für Instagram/TikTok. Token aus Apify Console.
APIFY_API_TOKEN=
APIFY_INSTAGRAM_ACTOR_ID=apify~instagram-scraper
APIFY_TIKTOK_ACTOR_ID=clockworks~tiktok-scraper
APIFY_RESULTS_LIMIT_PER_CHANNEL=5
APIFY_WAIT_SECONDS=1800
APIFY_POLL_INTERVAL_SECONDS=10

# --- Reports ---
REPORT_TIMEZONE=Europe/Berlin

# --- Secure Storage (Phase 4 W2: R2-Adapter aktiviert dies) ---
SECURE_STORAGE_ENABLED=false

# --- Storage-Backend (Adapter-Pattern: local | s3) ---
# `local` schreibt unter STORAGE_PATH ins lokale Filesystem (Default für Tests/Dev).
# `s3` schreibt via boto3 in einen S3-kompatiblen Bucket (Cloudflare R2 in Production).
# Die S3_*-Variablen sind nur bei STORAGE_BACKEND=s3 nötig.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_TTL_SECONDS=3600

# --- Rate-Limiting (Sicherheits-Audit 2026-07-01) ---
# In-Memory-Limiter auf /api/admin/login (Brute-Force) und den teuren
# Apify-/Vision-/Report-Endpoints. Kill-Switch, kein Multi-Instanz-Store.
RATE_LIMIT_ENABLED=true

# --- Image-Proxy ---
# Komma-separierte Liste erlaubter Host-Suffixe (CDN-Hostnamen).
# Muss die Frontend-Liste PROXY_HOST_SUFFIXES (frontend/src/api/imageUrl.js)
# abdecken — fehlt ein Host hier, lehnt der Server mit 403 ab, was das
# Frontend als kaputtes Bild zeigt (YouTube-Vorfall 22.08.2026).
IMAGE_PROXY_ALLOWED_HOSTS=cdninstagram.com,fbcdn.net,tiktokcdn.com,tiktokcdn-us.com,tiktokcdn-eu.com,ytimg.com,ggpht.com
IMAGE_PROXY_TIMEOUT_SECONDS=8.0
IMAGE_PROXY_MAX_BYTES=8388608

# --- Bearer-Token-Auth (Phase 4 W4 Task 4.3) ---
# Master switch: false = open API, true = Bearer-Auth required.
# Roll-out order is critical (see PHASE_4_DONE.md Lesson 5):
#   1. Deploy with AUTH_ENABLED=false (default)
#   2. Set API_TOKEN in Railway and VITE_API_TOKEN in Netlify (same value)
#   3. Wait for Frontend redeploy so the SPA carries the header
#   4. Flip AUTH_ENABLED=true
# Token: 32 hex bytes, openssl rand -hex 32. Public paths (Health, /api/img,
# Docs, /api/reports/latest/download.*) stay open regardless of the flag.
AUTH_ENABLED=false
API_TOKEN=

# --- Dedizierter Cron-Token (Sprint Security 16.06.2026) ---
# Wird ausschließlich auf POST /api/admin/cron/sync-all akzeptiert
# (Least-Privilege für den GitHub-Action-Wochenlauf). Audit 2026-08-17:
# der Fallback auf API_TOKEN ist abgeschafft — sync-all akzeptiert nur noch
# diesen Token oder eine Admin-Session. Das GitHub-Secret CR_API_TOKEN muss
# denselben Wert tragen. Siehe docs/ROTATION.md.
CRON_API_TOKEN=

# --- Produktions-Boot-Check (Audit 2026-08-17) ---
# In APP_ENV=production bricht der Start ab, wenn AUTH_ENABLED oder
# ADMIN_AUTH_ENABLED aus sind (API wäre offen). true = bewusster Override.
ALLOW_AUTH_DISABLED_IN_PRODUCTION=false

# --- Link-Preview-Allowlist (Audit 2026-08-17, SSRF) ---
# Host-Suffixe, die der Instagram-Link-Import fetchen darf; alles andere
# fällt auf "link-only" zurück (kein Fetch, kein internes Netz erreichbar).
LINK_PREVIEW_ALLOWED_HOSTS=instagram.com,instagr.am

# --- Admin-Session-Login (Sprint 28.05.2026) ---
# Zweite Auth-Schicht über dem Bearer-Token: Bearer beantwortet "richtiges
# Frontend?", die Admin-Session "richtiger User?". Rollout-Reihenfolge:
#   1. ADMIN_PASSWORD + ADMIN_SESSION_SECRET setzen
#   2. ADMIN_AUTH_ENABLED=true flippen
# Fehlt ADMIN_SESSION_SECRET oder ADMIN_PASSWORD während AUTH aktiv ist,
# antwortet der Login-Endpoint mit 503 (fail-closed), nicht mit offenem Zugriff.
ADMIN_PASSWORD=
# 32+ Byte Zufallsstring, z. B. `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_AUTH_ENABLED=false

# --- Cost-logging (Phase 4 W4 Task 4.4 / F0.6) ---
# Logging only, no hard cap (Phase 5+). USD->EUR conversion is static so it
# can be adjusted via Railway ENV without a code deploy.
USD_TO_EUR_RATE=0.92
APIFY_COMPUTE_UNIT_USD=0.4
# gpt-5.4-mini (2026-07-06, Re-Audit 2026-07-13). MEDIUM-HIGH CONFIDENCE, siehe
# config.py-Kommentar — mehrere unabhaengige Drittanbieter-Quellen konvergieren
# auf diese Werte, openai.com/api/pricing direkt bleibt aus dieser Sandbox
# blockiert (403).
OPENAI_INPUT_PER_1K_USD=0.00075
OPENAI_OUTPUT_PER_1K_USD=0.0045

# --- In-Process-Wochen-Trigger (Incident 2026-07-13) ---
# Default: true. Loest den woechentlichen Sync-Lauf (Montag 03:00-03:04 UTC,
# target_week=completed) direkt im Backend-Prozess aus statt ueber die
# GitHub-Action-Schedule (die 1,5-4,5h Verzoegerung hatte). Auf "false"
# setzen, um wieder rein auf den manuellen/GH-Actions-Trigger zu wechseln,
# z.B. waehrend eines Incidents am Trigger-Code selbst.
ENABLE_INTERNAL_CRON_SCHEDULER=true

# --- Title-Sync im Montag-Cron ---
# Default: true. Bei Incidents (TMDb-Outage, Rate-Limit, Catalog-Explosion)
# im Railway-UI auf "false" setzen; Title-Sync wird dann uebersprungen, die
# uebrigen Cron-Stufen laufen normal weiter. Kein Code-Deploy noetig zum Toggle.
ENABLE_TITLE_SYNC_IN_CRON=true

# --- Brief-Generation im Montag-Cron (Cadence-Sprint 2026-05-17) ---
# Default: true. Bei Incidents (Cost-Explosion, LLM-Outage, Mock-Leak) im
# Railway-UI auf "false" setzen; Brief-Gen wird dann uebersprungen, Scrape +
# Rematch laufen normal weiter. Kein Code-Deploy noetig zum Toggle.
ENABLE_BRIEF_GEN_IN_CRON=true

# --- Vision-Analyse-Caps im Cron (Sprint Beta) ---
# 0 deaktiviert den jeweiligen Schritt (z. B. für Tests).
# Wartung 20.08.2026: von 50/200 auf je 800 angehoben. Die alten Werte
# waren an einem Vision-Preis aus der gpt-4o-mini-Zeit kalibriert (0,015
# statt gemessener 0,0027 USD/Call) und lagen unter dem wöchentlichen
# Zufluss von ~680 Assets — der pending-Stapel wuchs schneller, als er
# geleert wurde, und die Instagram-CDN-Links darin verfallen nach 24-48h.
# Gegen Laufzeit schützt VISION_STAGE_TIMEOUT_SECONDS (siehe unten),
# nicht dieser Cap:
CRON_VISION_MAX_ASSETS_PER_RUN=800
CRON_VISION_BACKLOG_MAX_ASSETS_PER_RUN=800

# --- Monats-Budget-Caps (Sprint F0.6/F0.7 Hard-Cap-Vollausbau) ---
# Versicherung gegen Spike-Anomalien, kein Optimierungs-Hebel. *_ENFORCED=false
# deaktiviert den jeweiligen Hard-Cap komplett (Notfall-Kill-Switch).
APIFY_MONTHLY_BUDGET_USD=50.0
APIFY_SOFT_WARN_PCT=0.80
APIFY_HARD_CAP_PCT=1.00
APIFY_BUDGET_ENFORCED=true
ANTHROPIC_MONTHLY_BUDGET_USD=100.0
ANTHROPIC_SOFT_WARN_PCT=0.80
ANTHROPIC_HARD_CAP_PCT=1.00
ANTHROPIC_BUDGET_ENFORCED=true
# Incident 2026-07-13 — OpenAI war der einzige der drei kostenpflichtigen
# Provider ganz ohne Deckel. $50 spiegelt den Apify-Cap-Wert, siehe
# Begruendung im config.py-Kommentar.
OPENAI_MONTHLY_BUDGET_USD=50.0
OPENAI_SOFT_WARN_PCT=0.80
OPENAI_HARD_CAP_PCT=1.00
OPENAI_BUDGET_ENFORCED=true

# --- Citation-Validator (Sprint 28.05.2026, Evidenz-Block) ---
# false = Soft-Mode (nicht belegte cited_post_ids werden nur geloggt, Brief
# wird trotzdem ausgeliefert). true = Strict-Mode (löst Retry-Loop aus).
INSIGHT_CITATION_STRICT_ENFORCE=false

# --- Segment-Roundups im Montags-Cron (Master-Plan-Schritt-4) ---
# Komma-separierte Liste. Leerer/unparsebarer Gesamtwert → kein Roundup-Lauf.
CRON_ROUNDUP_SEGMENTS=us_major,us_independent,de_verleih,de_independent

# --- Cutter-Wochenbriefing Evidenz-Schwellen (Sprint 2026-06-12) ---
CUTTER_WEEKLY_MIN_POSTS=5
CUTTER_WEEKLY_MIN_DISTINCT_KEYS=3
CUTTER_WEEKLY_P75_WINDOW_WEEKS=8
CUTTER_WEEKLY_P75_MIN_SAMPLE=30

# --- Wochenbriefing-Feature-Flags (Cron-Block-Trockenlauf) ---
# false = Cron-Block wird uebersprungen (kein LLM-Call, kein Persist).
# Beide Flags unabhaengig voneinander schaltbar, kein Code-Deploy noetig.
FEATURE_CUTTER_WEEKLY_ENABLED=false
# Designer-Wochenbriefing (Sprint 2026-07-06) — teilt die Evidenz-Schwellen
# oben mit Cutter-Weekly (CUTTER_WEEKLY_*), nur die LLM-Lens unterscheidet
# sich. Default false, bis Wolf den Prompt-Output reviewt hat.
FEATURE_DESIGNER_WEEKLY_ENABLED=false

# --- Direkt per os.environ gelesene Cron-/DB-Variablen ---
# Diese liegen außerhalb der pydantic-Settings-Klasse, greifen aber genauso.
# Channel-Rotation im Sync-Cron:
CRON_A_CLASS_THRESHOLD=1
CRON_A_CLASS_MAX=30
# Steuert NUR die Channel-Rotation (compute_run_index/select_channels_for_cron,
# B-Klasse-Drittel je Lauf) — NICHT die Pair-Rotation für Briefs/Roundups, die
# ist abgeschafft (alle 9 Pairs laufen jeden Montag). Vor einem "das ist toter
# Code"-Verdacht: die Variable wird aktiv gelesen, siehe cron_channel_selection.py.
CRON_SYNC_INTERVAL_DAYS=3
# Stale-Run-Reap-Timeout für /api/admin/cron/sync-all (Minuten):
CRON_RUN_TIMEOUT_MINUTES=30
# Timeout für die Title-Sync-Stage im Cron (Sekunden). 1800s datengetrieben
# nachjustiert (2026-07-06) nach zwei sauberen Läufen à 516s/523s post
# Batch-Commit-Fix — siehe _title_sync_stage_timeout_seconds() für Details:
TITLE_SYNC_STAGE_TIMEOUT_SECONDS=1800
# Timeout für die Rematch-Stage im Cron (Sekunden). Verhindert, dass ein
# durch einen stark gewachsenen Titel-Katalog verlangsamter Rematch-Lauf
# das gesamte CRON_TOTAL_RUN_TIMEOUT_SECONDS-Budget verbraucht und Briefs/
# Roundups/Cutter-Weekly nie mehr laufen (Diagnose 2026-07-06):
REMATCH_STAGE_TIMEOUT_SECONDS=1800
# Timeout für die Post-Analyse-Stage im Cron (Sekunden). Neu nach dem
# Vorfall 10.08.2026: mit CRON_POST_ANALYSIS_MAX_POSTS_PER_RUN=2500 hat
# diese Stage den gesamten Lauf ins Gesamt-Timeout gezogen (~3,7s/Post ×
# 2500 = 2,5h zusätzlich zur Grundlaufzeit von ~7200s). Briefs, Roundups
# und Wochenbriefings fehlten komplett, weil sie hinter dieser Stage
# stehen. Ein Cap in *Posts* schützt nicht — er sagt nichts über Zeit.
# 1800s passen auch beim 9000s-Default des Gesamt-Timeouts (7200+1800).
# Bei CRON_TOTAL_RUN_TIMEOUT_SECONDS=12000 sind 3000s vertretbar.
# Siehe docs/VORFALL_2026-08-10_CRON_TIMEOUT.md:
CRON_POST_ANALYSIS_STAGE_TIMEOUT_SECONDS=1800
# Wieviele unklassifizierte Posts die Post-Analyse-Stage je Lauf höchstens
# anfasst. Reine KOSTENbremse (~$0,0029/Post text-only) — gegen Laufzeit
# schützt CRON_POST_ANALYSIS_STAGE_TIMEOUT_SECONDS darüber. 0 = Stage aus.
# Empfohlen 800: hält die ~500 wöchentlichen Neuzugänge ab und arbeitet
# nebenbei am Rückstand. Steht der Wert auf 0, fällt die Klassifikations-
# Abdeckung um rund 4 Prozentpunkte pro Woche:
CRON_POST_ANALYSIS_MAX_POSTS_PER_RUN=800
# Gemeinsames Zeitbudget BEIDER Vision-Stages im Cron (Sekunden): frische
# Assets + Backlog-Drain teilen sich diesen einen Zeitpunkt, damit die
# Summe begrenzt bleibt. Neu am 20.08.2026, gleiche Begründung wie bei der
# Post-Analyse oben: ein Cap in *Stück* sagt nichts über Laufzeit. Was
# nicht mehr hineinpasst, bleibt liegen und erscheint als
# "skipped_budget" im Cron-Summary. 0 = keine Zeitgrenze (Rückfallweg auf
# das alte Verhalten "nur Stückzahl begrenzt", ohne Code-Deploy):
VISION_STAGE_TIMEOUT_SECONDS=1800
# Vision-Call in der Post-Analyse auslassen (spart ~72% der Kosten je Post;
# format/tone/purpose/lifecycle_stage kommen aus der Caption):
CRON_POST_ANALYSIS_SKIP_VISION=true
# Server-seitiger Postgres statement_timeout (Millisekunden); 0 = aus.
PG_STATEMENT_TIMEOUT_MS=60000
# Globale Sicherheitsnetz-Deadline für den GESAMTEN Cron-Sync-Hintergrundlauf
# (Sekunden). Deckt jede Stage, nicht nur Title-Sync — falls eine Stage
# in Zukunft haengt, terminiert der Lauf garantiert und CronRun wird als
# "error" verbucht statt fuer Stunden/Tage auf "running" zu bleiben
# (Diagnose 2026-07-06). Auf 9000s (2,5h) angehoben (Re-Audit 2026-07-06):
# mit title_sync + rematch je auf eigenem 1800s-Timeout UND den weiterhin
# ungedeckelten Stages blieb bei 7200s nur noch ~2-7min Puffer.
CRON_TOTAL_RUN_TIMEOUT_SECONDS=9000
# Geteiltes Zeitfenster fuer den DATENBLOCK des Cron-Laufs (Sekunden):
# Scrape + Vision + Post-Analyse + Titel-Sync + Rematch teilen sich EIN
# Budget. Was nicht hineinpasst, wird uebersprungen (Summary:
# reason=data_budget_exceeded) und laeuft naechste Woche — die sechs
# LLM-Schlussstufen samt Playbook-Mail sind damit strukturell garantiert.
# Anlass 31.08.2026: der Lauf brauchte 224 von 240 erlaubten Minuten,
# und beim Reissen des Gesamtdeckels fiele genau das Produkt weg.
# 0 = Waechter aus. Evidence-Backfill und Kandidaten-Stufen laufen
# bewusst ausserhalb des Fensters (CDN-Verfall bzw. Sekunden-Stages).
CRON_DATA_STAGES_TIMEOUT_SECONDS=9000

# --- User-Login per E-Mail-Code (Sprint User-Login 2026-07) ---
# Dritte Auth-Schicht: personalisierte Sessions fuer Report-Nutzer.
# Rollout wie beim Admin-Login: erst Secret + Adressliste setzen, dann Flag.
USER_AUTH_ENABLED=false
# 32+ Byte Zufallsstring, z. B. `openssl rand -hex 32`.
USER_SESSION_SECRET=
# Komma-separierte Liste der E-Mail-Adressen mit Admin-Rechten im User-Login.
ADMIN_USER_EMAILS=
# Gueltigkeit der Login-Codes (Sekunden).
LOGIN_CODE_TTL_SECONDS=600
# Lebensdauer der Login-Session (Sekunden). Default 30 Tage — die Nutzer
# oeffnen Wochen-Briefs, ein woechentlicher Re-Login waere reine Reibung.
# Bewusste Abweichung von der 1h-JWT-TTL des Referenzprojekts.
USER_SESSION_TTL_SECONDS=2592000
# Rate-Limits fuer Code-Anforderung/Login (Fenster in Sekunden, Max je Fenster).
AUTH_RATE_WINDOW_SEC=300
AUTH_RATE_MAX_REQUEST_CODE=10
AUTH_RATE_MAX_LOGIN=5

# --- E-Mail-Versand (Login-Codes) ---
# resend | smtp. Bei "resend" reicht RESEND_API_KEY, bei "smtp" die SMTP_*.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Creative Radar
MAIL_TIMEOUT_SECONDS=30.0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# true = kein Versand, Codes landen nur im Log (Dev/Staging).
DISABLE_EMAILS=false
# Playbook-Montags-Mail (Radar): Komma-Liste der Empfaenger.
# Leer = kein Versand, der Cron-Block ueberspringt still.
PLAYBOOK_MAIL_RECIPIENTS=

# --- API-Docs ---
# false = /docs und /openapi.json sind in Production nicht erreichbar.
DOCS_PUBLIC=false

# --- Anthropic Prompt-Caching ---
# true = cache_control auf System-Prompts (spart Input-Tokens bei Briefs).
ANTHROPIC_PROMPT_CACHING=true

# --- Kandidaten-Autopilot (Channel-Kandidaten-Triage) ---
CANDIDATE_AUTOPILOT_ENABLED=true
CANDIDATE_AUTOPILOT_MIN_CONFIDENCE=0.85
# Ein-Wort-Titel brauchen die Safe-Marke des Matchers (Vorfall 24.08.2026):
# ein Einzelwort-Substring-Treffer bekommt dort 0.90 mit dem Vermerk
# "needs corroboration". Mit 0.85 bestaetigte der Autopilot genau diese
# Zufallstreffer — 83 Fehlzuordnungen an generische Streamer-Titel.
CANDIDATE_AUTOPILOT_MIN_CONFIDENCE_SINGLE_WORD=0.95
CANDIDATE_AUTOPILOT_STALE_DAYS=28
CANDIDATE_AUTOPILOT_STALE_MAX_CONFIDENCE=0.5

# --- KI-Pruefung der Rest-Vorschlaege als Cron-Stage (22.08.2026) ---
# Laeuft direkt nach dem Autopiloten; die Montags-Queue kommt vorgeprueft
# an. Batch-Deckel je Lauf (~2 Cent bei Haiku-Preisen fuer 60 Stueck).
CANDIDATE_LLM_ASSIST_IN_CRON=true
CANDIDATE_LLM_ASSIST_CRON_MAX=60

# --- Katalog-Nachladen als Cron-Stage (31.08.2026) ---
# Loest die "(nicht im Katalog)"-Faelle der KI-Pruefung direkt im Lauf
# auf (echter Lauf, kein Vorschau-Rollback) — statt jede Woche 40-50
# Titel von Hand anzulegen. Zusaetzlich gegated durch
# FEATURE_KATALOG_NACHLADEN_ENABLED; Deckel je Lauf (max. zwei
# TMDb-Suchen je Kandidat).
KATALOG_NACHLADEN_IN_CRON=true
KATALOG_NACHLADEN_CRON_MAX=50

# --- Empfehlungs-Snapshots (22.08.2026) ---
# Der Cron friert jede Woche die MACHEN-Empfehlungen des Muster-Berichts
# ein (Tabelle recommendation_snapshot) — Grundlage fuer das
# Vorher/Nachher-Design der Wir-Schleife. LLM-frei; nur Not-Aus.
RECOMMENDATION_SNAPSHOT_IN_CRON=true

# --- Evidence-Backfill im Cron (22.08.2026) ---
# Captures fuer junge Assets ohne gespeichertes Bild nachholen
# (transiente Scrape-Fehler; YouTube-Quellen verfallen nie).
# Zeit-Budget wird VOR jedem Asset geprueft (Vision-Muster).
EVIDENCE_BACKFILL_IN_CRON=true
EVIDENCE_BACKFILL_MAX_ASSETS=300
EVIDENCE_BACKFILL_BUDGET_SECONDS=600
EVIDENCE_BACKFILL_MAX_AGE_DAYS=14
# --- Streamer-Originals-Sync (Sprint §7, 22.08.2026) ---
# Serien-Kataloge von Netflix/Prime Video/Paramount+ ueber die
# TMDb-Network-Achse (with_networks) im Titel-Sync. Kill-Switch
# ohne Deploy.
STREAMER_TITLE_SYNC_ENABLED=true

# --- Segment-Roundups Feature-Flag (PR #155) ---
# Gate fuer den Roundup-Block im Montags-Cron und den Admin-Trigger.
FEATURE_SEGMENT_ROUNDUPS_ENABLED=false

# --- Trailer-Intelligence Feature-Flag (Staging-Fundament 20.08.2026) ---
# Gate fuer die Muster-Auswertung (Stufe 1): /api/insights/patterns-
# Endpunkte + Dashboard-Panel. Das Frontend liest den Zustand aus
# GET /api/health -> features. In Staging true, in Production false,
# bis die Ansicht abgenommen ist. Kein Cron-Block, keine LLM-Kosten.
FEATURE_TRAILER_INTELLIGENCE_ENABLED=false

# --- Deploy-Seeding (nur Staging/Dev; in production ignoriert) ---
# true = db_bootstrap legt beim Deploy synthetische Testdaten an.
SEED_DEV_ON_DEPLOY=false
SEED_DEV_PAIRS=disney,netflix

# --- Cron-Heartbeat / Dead-Man's-Switch (Diagnose-Folge 2026-07-06) ---
# Optionaler Healthchecks.io-artiger Ping nach jedem Cron-Lauf. Leer = kein
# Alerting (Default, bisheriges Verhalten). Beispiel: https://hc-ping.com/<uuid>
# — Erfolg pingt die Basis-URL, Fehlschlag haengt "/fail" an. So bekommst du
# sofort eine Push/E-Mail/SMS-Warnung von healthchecks.io (kostenloser Tarif
# reicht), statt erst beim naechsten Blick aufs Dashboard zu merken, dass der
# Montagslauf gehaengt oder gecrasht ist.
CRON_HEARTBEAT_URL=
